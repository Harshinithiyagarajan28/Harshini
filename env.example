# Gemini API key from Google AI Studio
GEMINI_API_KEY=put_your_gemini_key_here

# Hugging Face user access token
HF_TOKEN=put_your_huggingface_token_here

# Current Gemini model. Change only if your account/API supports another model.
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face text-to-image model
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_PROVIDER=auto

# huggingface = real image generation; mock = local placeholder images for UI testing
IMAGE_BACKEND=huggingface

PANEL_COUNT=5
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=4
IMAGE_TIMEOUT=180
DEBUG=true
